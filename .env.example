# El chat web funciona en modo guiado sin Google.
APP_URL=http://127.0.0.1:3100
MANABIT_DATA_DIR=.data
# En producción: PostgreSQL (Cloud SQL). Nunca SQLite en Cloud Run.
DATABASE_URL=
# Obligatorios en producción. Genera valores propios; no los pegues en el chat.
SESSION_SECRET=
ADMIN_PASSWORD=
MANABIT_TOOLS_TOKEN=
MANABIT_OWNER_TOOLS_TOKEN=
WORKER_TOKEN=
# Recurso de Agent Runtime. Se completa después de desplegar ADK.
GOOGLE_AGENT_ENGINE_ID=
GOOGLE_OWNER_AGENT_ENGINE_ID=
GOOGLE_AGENT_SESSION_METHOD=async_create_session
# Redes: mantener pausado hasta verificar las cuentas y los webhooks.
SOCIAL_AUTOMATION_ENABLED=false
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
